# Kisabella Financial Product Release — variables de entorno.
# Uso local: cp .env.example .env, rellena lo marcado (REQUIRED) y corre `docker compose up --build`.
# Nunca commitees .env.

# --- REQUIRED ---
# Tu propia llave (https://console.anthropic.com/). Cada evaluación hace ~5 llamadas al LLM con tu cuenta.
ANTHROPIC_API_KEY=
# Contraseña de Postgres (dueño y rol de app). Cualquier valor.
DB_PASSWORD=
# >= 32 caracteres. Genera: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# --- Opcional ---
ANTHROPIC_MODEL=claude-sonnet-4-6
# Búsqueda web del agente de Mercado (https://tavily.com). Sin ella, el agente funciona sin búsqueda.
TAVILY_API_KEY=
# Tipo de cambio oficial (https://www.banxico.org.mx/SieAPIRest/service/v1/token). Sin token, usa el TC manual.
BANXICO_TOKEN=
# IPs permitidas (CSV). Vacío = sin restricción (correcto en local; en servidor público, ponlas).
ALLOWED_IPS=
# URL de la API vista desde el navegador (se compila en el frontend) y origen del frontend para CORS.
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
APP_USER_ID=00000000-0000-0000-0000-000000000001
LOG_LEVEL=INFO
