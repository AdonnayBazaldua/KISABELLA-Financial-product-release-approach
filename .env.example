# =============================================================
# CAPI-KISABELLA — Variables de entorno
#
# Copia este archivo a `.env` y rellena los valores reales.
# Nunca commitees `.env` (está en .gitignore).
# =============================================================

# ---- Claude API ----
# Obtén la key en https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---- Tavily (búsqueda web para Agente de Mercado) ----
# Obtén la key en https://tavily.com/
TAVILY_API_KEY=

# ---- Banxico (tipo de cambio USD/MXN) ----
# Obtén el token en https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=

# ---- Base de datos PostgreSQL ----
# Password para el usuario `capi` de la BD `capi_kisabella`
DB_PASSWORD=

# DATABASE_URL la construye el backend desde DB_PASSWORD;
# si lo expones, debe apuntar al servicio `db` de docker-compose
DATABASE_URL=postgresql+psycopg://capi:${DB_PASSWORD}@db:5432/capi_kisabella

# ---- Seguridad ----
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# IPs autorizadas (whitelist en Nginx). Coma-separadas, sin espacios.
ALLOWED_IPS=127.0.0.1
