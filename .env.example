# =============================================================
# CAPI-KISABELLA — Variables de entorno
#
# Copia este archivo a `.env` y rellena los valores reales.
# Nunca commitees `.env` (está en .gitignore).
# El backend valida estas variables al startup con pydantic-settings.
# Falta de una required o formato inválido = crash inmediato.
# =============================================================

# ---- Claude API ----
# Obtén la key en https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modelo Claude. Default: claude-sonnet-4-6.
# ADR-007: stack LLM = langchain-anthropic + with_structured_output
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Tavily (búsqueda web para Agente de Mercado) ----
# Obtén la key en https://tavily.com/
# Opcional en dev — el agente Mercado entra en degradación graceful si falta.
TAVILY_API_KEY=

# ---- Banxico (tipo de cambio USD/MXN) ----
# Obtén el token en https://www.banxico.org.mx/SieAPIRest/service/v1/token
# Opcional en dev — fallback a último valor en DB con flag warn_fx.
BANXICO_TOKEN=

# ---- Base de datos PostgreSQL ----
# Password del rol capi_app (NO-owner per ADR-008).
DB_PASSWORD=

# DATABASE_URL: scheme debe ser postgresql://, postgresql+psycopg:// o postgresql+asyncpg://
# Solo postgresql es aceptado por el validator.
DATABASE_URL=postgresql+psycopg://capi_app:${DB_PASSWORD}@db:5432/capi_kisabella

# ---- Seguridad ----
# Mínimo 32 caracteres (validado en startup).
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# IPs autorizadas (whitelist en Nginx). Coma-separadas, sin espacios.
# Renderada por entrypoint.sh de Nginx (ADR-010).
ALLOWED_IPS=127.0.0.1

# ---- Contexto RLS (ADR-008) ----
# UUID del user activo para RLS de Postgres.
# 2-3 users internos = uno solo basta; el día que sumen usuarios, esto pasa a sesión.
APP_USER_ID=00000000-0000-0000-0000-000000000001

# ---- Frontend / red interna Docker ----
# Server Components corren en el contenedor; usan API_URL_INTERNAL.
# El browser usa NEXT_PUBLIC_API_URL (debe ser accesible públicamente).
API_URL_INTERNAL=http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Observabilidad ----
# Niveles válidos: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
